{
  "name": "maya",
  "version": "0.0.0",
  "description": "A female Jarvis-like voice agent — listens, asks, executes (browser + desktop), reports back by voice.",
  "type": "module",
  "module": "src/index.ts",
  "packageManager": "bun@1.3.3",
  "bin": {
    "maya": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts start",
    "dev": "bun --watch src/index.ts start",
    "typecheck": "tsc --noEmit",
    "build:overlay": "cd overlay && bun install && bun run build",
    "start:overlay": "cd overlay && bun run start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "commander": "^14.0.2",
    "playwright": "^1.50.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
